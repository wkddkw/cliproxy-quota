<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/row_symbol" android:layout_width="32dp" android:layout_height="32dp"
        android:gravity="center" android:background="@drawable/widget_circle" android:textColor="#163C30" android:textSize="20sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:orientation="vertical">
        <TextView android:id="@+id/row_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#163C30" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row_count" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#536B60" android:textSize="10sp" />
        <ProgressBar android:id="@+id/row_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="3dp"
            android:progressTint="#23846B" android:progressBackgroundTint="#D9E8DF" />
    </LinearLayout>
    <TextView android:id="@+id/row_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#163C30" android:textSize="24sp" android:textStyle="bold" />
</LinearLayout>
